{% from "partials/tool-chip.njk" import toolChip %}
<section class="section experience" id="experience">
  <div class="container">
    <h2 class="section-title">{{ site.experienceHeading }}</h2>
    <div class="timeline" id="experienceList">
      {% for job in site.experience %}
      <article class="timeline-item" data-tools="{{ job.tools | join(' ') }}">
        <div class="timeline-item-inner">
        <div class="timeline-head">
          <h3 class="timeline-role">{{ job.role }}</h3>
          {% if job.current %}<span class="pill">Current</span>{% endif %}
        </div>
        <p class="timeline-meta">{% if job.companyUrl %}<a href="{{ job.companyUrl }}" target="_blank" rel="noopener">{{ job.company }}</a>{% else %}{{ job.company }}{% endif %}{% if job.period %} · {{ job.period }}{% endif %}</p>
        {% if job.points and job.points.length %}
        <h4 class="timeline-subtitle">Highlights</h4>
        <ul class="timeline-points">
          {% for point in job.points %}<li>{{ point | safe }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% if job.dayToDay and job.dayToDay.length %}
        <div class="timeline-day">
          <h4 class="timeline-subtitle">Day to day</h4>
          <ul class="timeline-points">
            {% for d in job.dayToDay %}<li>{{ d | safe }}</li>{% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if job.tools and job.tools.length %}
        <div class="timeline-tools" aria-label="Tools used">
          {% for t in job.tools %}{{ toolChip(site.toolbox.groups, t) }}{% endfor %}
        </div>
        {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>