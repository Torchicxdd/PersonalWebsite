<footer class="footer" id="contact">
  <div class="container footer-inner">
    <div class="socials">
      {% for s in site.socials %}<a class="social-link" href="{{ s.url }}" {% if not s.url.startsWith('mailto:') %}target="_blank" rel="noopener"{% endif %} aria-label="{{ s.label }}"><img src="{{ s.icon }}" alt="{{ s.label }}"></a>{% endfor %}
    </div>
    <p class="footer-note">© {{ site.year }} {{ site.name }}</p>
  </div>
</footer>